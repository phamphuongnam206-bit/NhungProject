
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Nap code STM32 (ST-LINK)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\stm32.ps1",
        "-Action",
        "upload",
        "-SourceFile",
        "${fileBasename}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": false,
        "close": false,
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "2. Xem Serial (Chon COM)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\stm32.ps1",
        "-Action",
        "monitor"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true,
        "close": false,
        "showReuseMessage": false
      },
      "problemMatcher": []
    }
  ]
}
